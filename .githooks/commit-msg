#!/usr/bin/env bash
# Validates the commit message: Conventional Commits, first line <= 72 characters,
# blank line before the body.
# Activation: git config core.hooksPath .githooks && chmod +x .githooks/*

set -u

MSG_FILE="$1"
FIRST="$(head -1 "$MSG_FILE")"

# Merge, revert, fixup and squash messages are generated by git: let them through.
case "$FIRST" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

TYPES='feat|fix|docs|refactor|test|chore|perf|build|ci|style'
REGEX="^(${TYPES})(\([a-z0-9._/-]+\))?!?: .+"

fail() {
  echo ""
  echo "commit-msg: message rejected - $1"
  echo ""
  echo "  received: $FIRST"
  echo ""
  echo "  format:   <type>(<optional scope>)!?: <description>"
  echo "  types:    feat fix docs refactor test chore perf build ci style"
  echo "  examples: feat(resolve): honour the labels' date format"
  echo "            fix: reject a broken evidence path at validation time"
  echo "            docs: ADR-0006 code/data split"
  echo ""
  echo "  The why goes in the body, separated by a blank line."
  exit 1
}

if ! printf '%s' "$FIRST" | grep -Eq "$REGEX"; then
  fail "not a Conventional Commit"
fi

LENGTH=${#FIRST}
if [ "$LENGTH" -gt 72 ]; then
  fail "first line is $LENGTH characters (maximum 72)"
fi

SECOND="$(sed -n '2p' "$MSG_FILE")"
if [ -n "$SECOND" ]; then
  fail "missing blank line between title and body"
fi

exit 0
