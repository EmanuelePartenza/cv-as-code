{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview-prep.schema.json",
  "title": "Interview preparation frontmatter (users/<slug>/applications/<job_id>/interview-prep.md)",
  "description": "Output of stage 70_interview_prep (ADR-0005): an internal document with fact-grounded STAR stories and honest gap scripts. No gate; the fact-grounding rule holds: every story cites the facts it rests on.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "user", "job_id", "language", "created", "stories"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "interview-prep" },
    "user": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "job_id": { "type": "string", "pattern": "^\\d{8}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "language": { "type": "string", "pattern": "^[a-z]{2}$" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "source_facts"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "source_facts": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(exp|prj)-[a-z0-9-]+\\.f\\d{2}$" } }
        }
      }
    },
    "gaps_addressed": { "type": "array", "items": { "type": "string" }, "description": "The match's gap requirements, verbatim, each with a script in the body" }
  }
}
