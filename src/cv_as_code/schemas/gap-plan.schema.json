{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gap-plan.schema.json",
  "title": "Gap-closing plan frontmatter (users/<slug>/growth/<job_id>.md)",
  "description": "Output of stage 40_gap_plan: for each gap a match declared, what the user already has (fact-cited), a closing path whose steps deliver evidence, and candidate facts that are future claims — never written to the profile by anyone but the user through extraction and verification. Internal document, no gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "user", "job_id", "created", "gaps"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "gap-plan" },
    "user": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "job_id": { "type": "string", "pattern": "^\\d{8}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "kind", "adjacent_facts", "path"],
        "properties": {
          "requirement": { "type": "string", "minLength": 1, "description": "Verbatim from the match" },
          "kind": { "enum": ["must", "nice"] },
          "adjacent_facts": { "type": "array", "items": { "type": "string", "pattern": "^(exp|prj)-[a-z0-9-]+\\.f\\d{2}$" }, "description": "Existing facts adjacent to the requirement; empty when nothing is" },
          "path": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["deliverable", "artefact"],
              "properties": {
                "deliverable": { "type": "string", "minLength": 1 },
                "artefact": { "type": "string", "minLength": 1, "description": "What would exist afterwards and could be extracted as evidence" },
                "effort": { "type": ["string", "null"] }
              }
            }
          },
          "candidate_facts": { "type": "array", "items": { "type": "string" }, "description": "Future claims, labelled as such; never in the profile until evidenced and verified" }
        }
      }
    }
  }
}
