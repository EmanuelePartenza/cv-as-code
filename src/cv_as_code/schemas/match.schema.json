{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match.schema.json",
  "title": "Match verdict (users/<slug>/matches/<job_id>.yaml)",
  "description": "Output of stage 20_match: an honest fit analysis of one posting for one user. No numeric score (false precision). Strengths cite facts; gaps quote requirements. Kept even when the verdict is skip.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "user", "job_id", "verdict", "strengths", "gaps", "angle", "confidential_flags", "created"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "match" },
    "user": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "job_id": { "type": "string", "pattern": "^\\d{8}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "verdict": {
      "enum": ["apply", "stretch", "skip"],
      "description": "apply: every must requirement is evidenced · stretch: must gaps with adjacent evidence · skip: a hard blocker"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_facts"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "description": "In the user's pivot language" },
          "source_facts": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Fact ids in the profile" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "kind", "note"],
        "properties": {
          "requirement": { "type": "string", "minLength": 1, "description": "Quoted from job.yaml requirements" },
          "kind": { "enum": ["must", "nice"] },
          "note": { "type": "string", "minLength": 1, "description": "What the profile has, or has not, that is adjacent; honest" }
        }
      }
    },
    "angle": { "type": "string", "minLength": 1, "description": "The honest positioning for this posting, in the user's pivot language" },
    "confidential_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "When the search is confidential: steps or forms in this posting that would expose it"
    },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
