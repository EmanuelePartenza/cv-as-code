# Project commands - the single source for the verification engine, the skills and
# the git hooks.
#
# Copy this file to `.claude/project.conf` and fill in what applies. `project.conf`
# is NOT versioned (it may hold machine-specific paths).
#
# Syntax: POSIX shell, one assignment per line, quoted values. Leave a gate empty
# (or commented) if it does not exist: verify.sh skips it instead of failing.

# --- Interpreter / environment ------------------------------------------------
PY=".venv/bin/python"

# --- Deterministic gates ------------------------------------------------------
# Run by `bash .claude/scripts/verify.sh` in this order.

# Formatting must be the check, not the rewrite (use --check).
CMD_FORMAT=".venv/bin/ruff format --check ."
CMD_LINT=".venv/bin/ruff check ."
CMD_TYPES=""
CMD_TEST=".venv/bin/python -m pytest -q"

# Extra project-specific gates (boundaries, guardrails, security...). Numbered;
# verify.sh runs them all, also with --quick.
CMD_EXTRA_1=".venv/bin/python -m pytest -q tests/test_publication_boundary.py"
CMD_EXTRA_1_NAME="publication boundary"

# Maintainer only: the keyed denylist must be active on the machine that publishes.
CMD_EXTRA_2="test -s \"${XDG_CONFIG_HOME:-$HOME/.config}/cvac/denylist.key\""
CMD_EXTRA_2_NAME="denylist key present"

CMD_EXTRA_3=""
CMD_EXTRA_3_NAME=""

# --- Non-gate commands --------------------------------------------------------
CMD_RUN=""
CMD_INSTALL="make install"
